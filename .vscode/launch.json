{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (open one-deploy)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "M:/Github/one-deploy"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: build"
    }
  ]
}
